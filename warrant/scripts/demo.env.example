# Machine-specific settings for the demo scripts.
# Copy to warrant/scripts/demo.env (not committed) and edit. Read by start_demo.sh
# (the desktop icon) and run_all.sh. Shell syntax: NAME="value", no spaces around "=".

# Agent backend: openclaw (default) or direct (calls the model at LLM_BASE_URL itself)
# WARRANT_AGENT_BACKEND="openclaw"

# How to reach the NemoClaw-managed OpenClaw agent ({agent}, {session_id}, {message} are filled in)
# WARRANT_OPENCLAW_CMD="openclaw agent --agent {agent} --local --session-id {session_id} --message {message}"
# WARRANT_OPENCLAW_AGENT="main"

# Direct backend only
# LLM_BASE_URL="http://localhost:8000/v1"
# LLM_MODEL=""

# Command that opens the dashboard (default: xdg-open on Linux, open on macOS)
# DASHBOARD_OPEN_CMD="xdg-open"
